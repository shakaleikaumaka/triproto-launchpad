# ── triproto-fetch-cli environment ──────────────────────────────────────────
# Copy to .env and `chmod 600 .env`. The .env file is gitignored — NEVER commit it.
#
# REQUIRED for --yes (token record creation via the Agent Launch API):
#   Get a key at https://agentverse.ai/profile/api-keys
AGENTVERSE_API_KEY=

# Deployer identity (choose ONE):
#   a) FET_DEPLOYER_KEY — hex private key of the FET deployer wallet.
#      Used ONLY LOCALLY to derive the deployer address (ethers.Wallet().address).
#      It is never sent anywhere: token deployment on this platform is completed
#      by a HUMAN via a handoff link (MetaMask), not by this tool.
FET_DEPLOYER_KEY=
#   b) DEPLOYER_ADDRESS — address-only mode (dry-run + pre-flight work with no
#      key material on disk at all). Preferred for dry-runs.
DEPLOYER_ADDRESS=0x25965899f4600b3AA5362ee4f34be95E5E62c934

# OPTIONAL overrides:
# BSC_RPC=https://bsc.publicnode.com
# FET_BUFFER=25        # extra FET headroom required on top of cohort fees
