# ── LANE D · Hedera x402 rail ─────────────────────────────────────────────
# Testnet demo accounts ONLY. Never put mainnet keys here.
#
# FAST PATH (existing funded account, e.g. Shaka's 0.0.10511368):
#   fill PAYER_KEY + PAYER_ACCOUNT_ID below → `npm run setup` mirror-checks
#   it (exists+balance), SKIPS hollow-account completion, and auto-creates
#   the receiver. ED25519 and ECDSA DER hex keys are both accepted.
#
# FRESH PATH (from scratch):
#   1) generate two ECDSA keypairs (node scripts/genkeys.mjs, or any tool)
#   2) paste PAYER_EVM at https://portal.hedera.com/faucet (anonymous, 10 tℏ/day)
#   3) npm run setup → completes payer hollow account + auto-creates receiver

PAYER_KEY=<DER hex, ED25519 or ECDSA — no 0x needed>
PAYER_EVM=0x<derived 20-byte EVM address>          # fresh path only
PAYER_ACCOUNT_ID=                                   # fast path: pre-funded account id; fresh path: filled by npm run setup
RECEIVER_KEY=0x<64-hex ECDSA private key>
RECEIVER_EVM=0x<derived 20-byte EVM address>
RECEIVER_ACCOUNT_ID=                                # filled by npm run setup

# Blocky402 hosted testnet facilitator (open access, no API key)
FACILITATOR_URL=https://api.testnet.blocky402.com

HEDERA_NETWORK=hedera:testnet
PORT=4021
PRICE_TINYBARS=100000        # 0.001 HBAR per request

# Offline demos only — uses the clearly-labeled local mock, NO chain writes:
# MOCK_FACILITATOR=1
# MOCK_PORT=4402
