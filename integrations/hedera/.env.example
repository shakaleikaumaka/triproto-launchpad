# ── LANE D · Hedera x402 rail ─────────────────────────────────────────────
# Testnet demo accounts ONLY. Never put mainnet keys here.
# 1) generate two ECDSA keypairs (node scripts/genkeys.mjs or any tool)
# 2) paste PAYER_EVM at https://portal.hedera.com/faucet (anonymous, 10 tℏ/day)
# 3) npm run setup   → completes payer + auto-creates receiver + fills IDs below

PAYER_KEY=0x<64-hex ECDSA private key>
PAYER_EVM=0x<derived 20-byte EVM address>
PAYER_ACCOUNT_ID=            # filled by npm run setup
RECEIVER_KEY=0x<64-hex ECDSA private key>
RECEIVER_EVM=0x<derived 20-byte EVM address>
RECEIVER_ACCOUNT_ID=         # filled by npm run setup

# Blocky402 hosted testnet facilitator (open access, no API key)
FACILITATOR_URL=https://api.testnet.blocky402.com

HEDERA_NETWORK=hedera:testnet
PORT=4021
PRICE_TINYBARS=100000        # 0.001 HBAR per request

# Offline demos only — uses the clearly-labeled local mock, NO chain writes:
# MOCK_FACILITATOR=1
# MOCK_PORT=4402
